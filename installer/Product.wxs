<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="Smart Ledger" 
           Language="1033" 
           Version="1.0.0" 
           Manufacturer="Smart Ledger" 
           UpgradeCode="C7B387F0-9F31-4F2A-8C39-05E8BC29B120">
    
    <Package InstallerVersion="301" 
             Compressed="yes" 
             InstallScope="perMachine" 
             
             Description="Smart Ledger Accounting System Installation Package"
             Comments="Professional Accounting Software for Windows 10 and 11" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="assets/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="http://localhost:3000" />
    <Property Id="ARPURLINFOABOUT" Value="http://localhost:3000" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Smart Ledger">
  <Component Id="cmp_root" Guid="8105933A-DFEC-5F55-98E4-B70C451E5F80" Win64="yes">
    <File Id="fil_SmartLedger_exe" Source="staging/SmartLedger.exe" KeyPath="yes">
      <Shortcut Id="AppDesktopShortcut" Directory="DesktopFolder" Name="Smart Ledger" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="no" />
      <Shortcut Id="AppStartMenuShortcut" Directory="ApplicationProgramsFolder" Name="Smart Ledger" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="no" />
    </File>
    <File Id="fil_icon_ico" Source="staging/icon.ico" KeyPath="no" />
    <File Id="fil_index_html" Source="staging/index.html" KeyPath="no" />
    <File Id="fil_manifest_webmanifest" Source="staging/manifest.webmanifest" KeyPath="no" />
    <File Id="fil_node_exe" Source="staging/node.exe" KeyPath="no" />
    <File Id="fil_registerSW_js" Source="staging/registerSW.js" KeyPath="no" />
    <File Id="fil_server_cjs" Source="staging/server.cjs" KeyPath="no" />
    <File Id="fil_server_cjs_map" Source="staging/server.cjs.map" KeyPath="no" />
    <File Id="fil_stop_bat" Source="staging/stop.bat" KeyPath="no" />
    <RegistryValue Root="HKCU" Key="Software\SmartLedger" Name="installed" Type="integer" Value="1" KeyPath="no" />
  </Component>
<Directory Id="dir_assets" Name="assets">
  <Component Id="cmp_assets" Guid="1F23F9D3-3B4C-5A9E-92C9-722A593D0BE2" Win64="yes">
    <File Id="fil_assets_icon_ico" Source="staging/assets/icon.ico" KeyPath="no" />
    <File Id="fil_assets_icon_png" Source="staging/assets/icon.png" KeyPath="no" />
    <File Id="fil_assets_index_Bmd2U3HW_css" Source="staging/assets/index-Bmd2U3HW.css" KeyPath="no" />
    <File Id="fil_assets_index_atsQXhAE_js" Source="staging/assets/index-atsQXhAE.js" KeyPath="no" />
    <File Id="fil_assets_index_es_C_YLGyI1_js" Source="staging/assets/index.es-C_YLGyI1.js" KeyPath="no" />
    <File Id="fil_assets_purify_es_CAi2OJFm_js" Source="staging/assets/purify.es-CAi2OJFm.js" KeyPath="no" />
  </Component>
<Directory Id="dir_assets_aistudio" Name="aistudio">
  <Component Id="cmp_assets_aistudio" Guid="54EAB2DA-2064-57C4-905F-661EA3B73246" Win64="yes">
    <File Id="fil_assets_aistudio__gitignore" Source="staging/assets/aistudio/.gitignore" KeyPath="no" />
  </Component>
</Directory>
</Directory>
<Directory Id="dir_data" Name="data">
  <Component Id="cmp_data" Guid="E78AED5E-A5B3-5F0A-BA46-D0703D0C7F76" Win64="yes">
    <File Id="fil_data_database_json" Source="staging/data/database.json" KeyPath="no" />
  </Component>
</Directory>
<Directory Id="dir_dist" Name="dist">
  <Component Id="cmp_dist" Guid="9222445F-2AD8-5B9E-B64C-3D2C7C19BAEC" Win64="yes">
    <File Id="fil_dist_index_html" Source="staging/dist/index.html" KeyPath="no" />
    <File Id="fil_dist_manifest_webmanifest" Source="staging/dist/manifest.webmanifest" KeyPath="no" />
    <File Id="fil_dist_registerSW_js" Source="staging/dist/registerSW.js" KeyPath="no" />
  </Component>
<Directory Id="dir_dist_assets" Name="assets">
  <Component Id="cmp_dist_assets" Guid="E795544E-E71E-5758-BA53-39CA88039035" Win64="yes">
    <File Id="fil_dist_assets_index_Bmd2U3HW_css" Source="staging/dist/assets/index-Bmd2U3HW.css" KeyPath="no" />
    <File Id="fil_dist_assets_index_atsQXhAE_js" Source="staging/dist/assets/index-atsQXhAE.js" KeyPath="no" />
    <File Id="fil_dist_assets_index_es_C_YLGyI1_js" Source="staging/dist/assets/index.es-C_YLGyI1.js" KeyPath="no" />
    <File Id="fil_dist_assets_purify_es_CAi2OJFm_js" Source="staging/dist/assets/purify.es-CAi2OJFm.js" KeyPath="no" />
  </Component>
<Directory Id="dir_dist_assets_aistudio" Name="aistudio">
  <Component Id="cmp_dist_assets_aistudio" Guid="CC93B065-2A16-5781-8510-4446D39FD760" Win64="yes">
    <File Id="fil_dist_assets_aistudio__gitignore" Source="staging/dist/assets/aistudio/.gitignore" KeyPath="no" />
  </Component>
</Directory>
</Directory>
</Directory>
<Directory Id="dir_runtime" Name="runtime">
  <Component Id="cmp_runtime" Guid="E30FFA8E-2401-58BE-8BA8-5F6FE6D9F523" Win64="yes">
    <File Id="fil_runtime_node_exe" Source="staging/runtime/node.exe" KeyPath="no" />
  </Component>
</Directory>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Smart Ledger">
          <Component Id="cmp_StartMenuShortcut" Guid="CC3A198D-6785-5093-88A9-D92FA2F6D02F" Win64="yes">
            <RemoveFolder Id="CleanUpAppProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\SmartLedger" Name="startmenu_installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Feature Id="MainApplication" Title="Smart Ledger" Level="1" Display="expand" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="cmp_StartMenuShortcut" />
      <ComponentRef Id="cmp_root" />
      <ComponentRef Id="cmp_assets" />
      <ComponentRef Id="cmp_assets_aistudio" />
      <ComponentRef Id="cmp_data" />
      <ComponentRef Id="cmp_dist" />
      <ComponentRef Id="cmp_dist_assets" />
      <ComponentRef Id="cmp_dist_assets_aistudio" />
      <ComponentRef Id="cmp_runtime" />
    </Feature>
  </Product>
</Wix>
