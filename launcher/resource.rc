1 ICON "../assets/icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Smart Ledger"
            VALUE "FileDescription", "Smart Ledger Accounting Desktop Launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SmartLedger"
            VALUE "LegalCopyright", "Copyright (C) 2026 Smart Ledger"
            VALUE "OriginalFilename", "SmartLedger.exe"
            VALUE "ProductName", "Smart Ledger Accounting System"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
